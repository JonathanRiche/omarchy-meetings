        ["10:00", "11:30", "Backlog refinement", "Work"],
        ["15:00", "16:00", "Customer call", "Work"]],
    2: [["09:00", "09:15", "Standup", "Work"],
        ["10:00", "13:00", "Architecture workshop", "Shared"],
        ["14:00", "15:00", "Retro", "Work"],
        ["19:30", "21:00", "Gym", "Personal"]],
    3: [["09:00", "09:15", "Standup", "Work"],
        ["09:30", "10:30", "Pairing on the importer", "Work"],
        ["12:00", "13:00", "Lunch with Sam", "Personal"]],
    4: [["09:00", "09:15", "Standup", "Work"],
        ["11:00", "12:00", "Sprint demo", "Work"],
        ["15:00", "16:00", "Week wrap-up", "Work"]],
    5: [["09:00", "10:30", "Bootcamp", "Personal"]],
    6: [],
}

# Which demo appointments carry a meeting link, so the row of buttons in the
# detail card is not something that only exists in theory.
DEMO_MEET = ["Standup", "Design review", "Backlog refinement", "Customer call",
